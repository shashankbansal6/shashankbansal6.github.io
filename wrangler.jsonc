{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shashankbansal-io",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // run the Worker first so the www → apex redirect applies to every path
    "run_worker_first": true
  },
  // Custom Domains: Cloudflare creates the DNS records + TLS certs on first deploy.
  "routes": [
    { "pattern": "shashankbansal.io", "custom_domain": true },
    { "pattern": "www.shashankbansal.io", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
